{
  "name": "naylence-runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Naylence Runtime - Complete TypeScript runtime including core Fame protocol and utilities",
  "author": "Naylence Dev <naylencedev@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "messaging",
    "ai",
    "agents",
    "platform",
    "naylence",
    "typescript",
    "runtime",
    "fame",
    "protocol",
    "logging",
    "tasks",
    "async"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naylence/naylence-runtime-ts"
  },
  "bugs": {
    "url": "https://github.com/naylence/naylence-runtime-ts/issues"
  },
  "homepage": "https://github.com/naylence/naylence-runtime-ts#readme",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:cjs && npm run build:esm && npm run build:browser",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs --target es2020",
    "build:esm": "tsc --module es2020 --outDir dist/esm --target es2020",
    "build:browser": "rollup -c rollup.config.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "tsc --watch --outDir dist/esm",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "naylence-core": "file:../naylence-core-ts",
    "naylence-factory": "file:../naylence-factory-ts",
    "yaml": "^2.6.0",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "better-sqlite3": "^12.4.1",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "fake-indexeddb": "^6.2.2",
    "jest": "^30.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.3",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
