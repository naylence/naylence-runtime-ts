{
  "name": "@naylence/runtime",
  "version": "0.4.5",
  "type": "module",
  "description": "Naylence Runtime - Complete TypeScript runtime",
  "author": "Naylence Dev <naylencedev@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "messaging",
    "ai",
    "agents",
    "platform",
    "naylence",
    "typescript",
    "runtime",
    "fame",
    "protocol",
    "logging",
    "tasks",
    "async"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naylence/naylence-runtime-ts.git"
  },
  "bugs": {
    "url": "https://github.com/naylence/naylence-runtime-ts/issues"
  },
  "homepage": "https://github.com/naylence/naylence-runtime-ts#readme",
  "main": "dist/node/node.cjs",
  "module": "dist/node/node.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": {
        "import": "./dist/browser/index.mjs",
        "require": "./dist/browser/index.cjs",
        "default": "./dist/browser/index.mjs"
      },
      "import": "./dist/node/node.mjs",
      "require": "./dist/node/node.cjs",
      "default": "./dist/node/node.mjs"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node/node.mjs",
      "require": "./dist/node/node.cjs"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.cjs"
    },
    "./install-env": {
      "types": "./dist/types/install-env.d.ts",
      "import": "./dist/esm/install-env.js",
      "require": "./dist/cjs/install-env.js",
      "default": "./dist/esm/install-env.js"
    },
    "./factory-manifest": {
      "types": "./dist/types/naylence/fame/factory-manifest.d.ts",
      "import": "./dist/esm/naylence/fame/factory-manifest.js",
      "require": "./dist/cjs/naylence/fame/factory-manifest.js",
      "default": "./dist/esm/naylence/fame/factory-manifest.js"
    },
    "./register-runtime-factories": {
      "types": "./dist/types/naylence/fame/util/register-runtime-factories.d.ts",
      "import": "./dist/esm/naylence/fame/util/register-runtime-factories.js",
      "require": "./dist/cjs/naylence/fame/util/register-runtime-factories.js",
      "default": "./dist/esm/naylence/fame/util/register-runtime-factories.js"
    },
    "./naylence/fame/connector/broadcast-channel-connector": {
      "types": "./dist/types/naylence/fame/connector/broadcast-channel-connector.browser.d.ts",
      "browser": {
        "import": "./dist/esm/naylence/fame/connector/broadcast-channel-connector.browser.js",
        "require": "./dist/cjs/naylence/fame/connector/broadcast-channel-connector.browser.js",
        "default": "./dist/esm/naylence/fame/connector/broadcast-channel-connector.browser.js"
      },
      "import": "./dist/esm/naylence/fame/connector/broadcast-channel-connector.node.js",
      "require": "./dist/cjs/naylence/fame/connector/broadcast-channel-connector.node.js",
      "default": "./dist/esm/naylence/fame/connector/broadcast-channel-connector.node.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "import": "./dist/esm/plugin.js",
      "require": "./dist/cjs/plugin.js",
      "default": "./dist/esm/plugin.js"
    },
    "./naylence/fame/config/extended-fame-config.js": {
      "types": "./dist/types/naylence/fame/config/extended-fame-config.d.ts",
      "browser": {
        "import": "./dist/esm/naylence/fame/config/extended-fame-config.browser.js",
        "require": "./dist/cjs/naylence/fame/config/extended-fame-config.browser.js",
        "default": "./dist/esm/naylence/fame/config/extended-fame-config.browser.js"
      },
      "import": "./dist/esm/naylence/fame/config/extended-fame-config.js",
      "require": "./dist/cjs/naylence/fame/config/extended-fame-config.js",
      "default": "./dist/esm/naylence/fame/config/extended-fame-config.js"
    },
    "./*": {
      "types": "./dist/types/*",
      "browser": "./dist/esm/*",
      "import": "./dist/esm/*",
      "require": "./dist/cjs/*",
      "default": "./dist/esm/*"
    }
  },
  "browser": {
    "./dist/node/index.mjs": "./dist/browser/index.mjs",
    "./dist/node/index.cjs": "./dist/browser/index.cjs",
    "fastify": false,
    "@fastify/websocket": false,
    "@fastify/formbody": false,
    "better-sqlite3": false,
    "express": false,
    "pino": false,
    "pino-pretty": false,
    "fs": false,
    "readline": false,
    "crypto": false,
    "ws": false,
    "node:net": false,
    "node:module": false,
    "node:fs": false,
    "node:fs/promises": false,
    "node:path": false,
    "node:crypto": false,
    "node:url": false
  },
  "sideEffects": [
    "**/*-factory.ts",
    "**/*-factory.js",
    "**/storage/index.ts",
    "**/storage/index.js",
    "dist/browser/index.mjs",
    "dist/browser/index.cjs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc --emitDeclarationOnly --outDir dist/types && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && rollup -c rollup.config.js && node ./scripts/fix-source-maps.js",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:browser": "rollup -c rollup.config.js",
    "fix-source-maps": "node ./scripts/fix-source-maps.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test-all": "npm run test:node && npm run test:browser",
    "test:node": "jest",
    "test:browser": "vitest run",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "tsc --watch --outDir dist/esm",
    "generate:factory-manifest": "node ./scripts/generate-factory-manifest.mjs",
    "inject-version": "node ./scripts/inject-version.js",
    "prebuild": "node ./scripts/inject-version.js && node ./scripts/generate-factory-manifest.mjs",
    "predev": "node ./scripts/inject-version.js && node ./scripts/generate-factory-manifest.mjs",
    "prepublishOnly": "node ./scripts/run-pm.js build && node ./scripts/run-pm.js test",
    "example:docker-rpc": "make -C examples/docker-rpc up",
    "example:docker-rpc:down": "make -C examples/docker-rpc clean",
    "analyze:size": "size-limit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.2.0",
    "@naylence/core": "^0.3.6",
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@peculiar/asn1-csr": "^2.5.0",
    "@peculiar/asn1-schema": "^2.5.0",
    "@peculiar/asn1-x509": "^2.5.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "yaml": "^2.6.0",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "better-sqlite3": "^12.4.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@size-limit/preset-small-lib": "^11.1.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.6.0",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^20.0.10",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.3",
    "size-limit": "^11.1.5",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.5",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.6",
    "ws": "^8.18.0"
  },
  "size-limit": [
    {
      "name": "browser entry",
      "path": "dist/esm/browser.js",
      "limit": "110 KB",
      "gzip": true,
      "brotli": true
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
